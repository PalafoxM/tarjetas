+
+            if (!isDownloadLink) {
+                return;
+            }
+
+            suppressNextNavigationLoader = true;
+            window.setTimeout(function () {
+                suppressNextNavigationLoader = false;
+                hideOverlay();
+            }, 800);
+        }, true);
+
         window.addEventListener('beforeunload', function () {
+            if (suppressNextNavigationLoader) {
+                suppressNextNavigationLoader = false;
+                hideOverlay();
+                return;
+            }
             showOverlay();
         });
     }
